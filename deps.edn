{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.994"}
        org.xerial/sqlite-jdbc {:mvn/version "3.49.0.0"}
        org.clojure/data.csv {:mvn/version "1.1.0"}}
 :aliases
 {:repl {:extra-paths ["dev"]}
  :dev {:extra-paths ["dev"]
        :extra-deps {com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.4.0"}
                     com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.1"}
                     com.github.clojure-lsp/clojure-lsp {:mvn/version "2026.05.05-12.58.26"}}
        :jvm-opts ["-Djdk.attach.allowAttachSelf"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      nubank/matcher-combinators {:mvn/version "3.10.0"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts  ["-m" "cognitect.test-runner"]}}}
